{
  "name": "skills-visualizer",
  "version": "0.0.0",
  "private": true,
  "description": "Local web app that scans a repo's Cursor agent configuration into a graph with provenance.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts dev",
    "scan": "tsx src/cli/main.ts scan",
    "start": "tsx src/cli/main.ts serve",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "3.1.1",
    "@hono/node-server": "2.1.5",
    "@types/hast": "^3.0.5",
    "d3": "7.9.0",
    "diff": "9.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "4.13.13",
    "picomatch": "4.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "^11.1.2",
    "tinyglobby": "0.2.17",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/d3": "7.4.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
