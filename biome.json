{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!**/fixtures", "!!**/dist", "!!**/.cursor", "!!**/overlays", "!!**/docs"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**", "src/scanner/**", "src/layout/**", "src/source-editing/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "d3",
                      "d3-*",
                      "tinyglobby"
                    ],
                    "message": "Pure core modules must not depend on server, UI, or Node-only packages."
                  },
                  {
                    "group": [
                      "**/server",
                      "**/server/**",
                      "**/web",
                      "**/web/**",
                      "**/cli",
                      "**/cli/**"
                    ],
                    "message": "Pure core modules must not import src/server, src/web, or src/cli."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/scanner/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["src/web/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
